# --- Google Sheets (Service Account) ---
# ID de la sheet (lo ves en la URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
GOOGLE_SHEET_ID=1RqZYKqW3pf0gLlVUgl2AwKuy1v5om7pWrYk6y4Mr65c

# Nombre de la hoja/tab dentro del spreadsheet (pestaña inferior). Si tenés una sola, suele ser "Hoja 1" o "Sheet1".
GOOGLE_SHEET_TAB=Hoja 1

# Credenciales del Service Account (Google Cloud > IAM > Service Accounts > Keys > JSON).
# client_email tal cual viene en el JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com

# private_key tal cual viene en el JSON, pero en UNA SOLA LINEA con \n literales en vez de saltos de linea reales.
# Ejemplo: "-----BEGIN PRIVATE KEY-----\nMIIEva...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_ACA\n-----END PRIVATE KEY-----\n"

# --- TMDB (The Movie Database) ---
# Conseguila gratis en https://www.themoviedb.org/settings/api ("API Key (v3 auth)")
TMDB_API_KEY=tu_api_key_de_tmdb
